rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /carousel_photos/{photoId} {
      allow read: if true;
      allow create: if request.resource.data.id is string
                    && request.resource.data.url is string
                    && request.resource.data.title is string;
      allow update: if request.resource.data.id is string
                    && request.resource.data.url is string;
      allow delete: if true;
    }

    match /rsvps/{rsvpId} {
      allow read: if true;
      allow create: if request.resource.data.fullName is string
                    && request.resource.data.phone is string
                    && request.resource.data.attending is bool;
      allow update: if request.resource.data.fullName is string;
      allow delete: if true;
    }
  }
}
