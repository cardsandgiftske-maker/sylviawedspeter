{
  "entities": {
    "carouselPhoto": {
      "title": "Carousel Photo",
      "description": "A wedding gallery photo displayed in the hero carousel",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the photo"
        },
        "url": {
          "type": "string",
          "description": "Image data URL or cloud storage URL"
        },
        "title": {
          "type": "string",
          "description": "Short descriptive title of the moment or venue"
        },
        "subtitle": {
          "type": "string",
          "description": "Optional subtitle"
        },
        "order": {
          "type": "number",
          "description": "Display order index in carousel"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of when the photo was added"
        },
        "isUserUploaded": {
          "type": "boolean",
          "description": "Whether this is uploaded by the couple"
        }
      },
      "required": ["id", "url", "title", "createdAt"]
    },
    "rsvpGuest": {
      "title": "RSVP Guest",
      "description": "Guest RSVP confirmation and details",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the RSVP"
        },
        "fullName": {
          "type": "string",
          "description": "Full name of the attending guest"
        },
        "phoneNumber": {
          "type": "string",
          "description": "Guest phone number"
        },
        "willAttend": {
          "type": "string",
          "enum": ["yes", "no"],
          "description": "Whether the guest will attend"
        },
        "adultsCount": {
          "type": "number",
          "description": "Number of adults"
        },
        "childrenCount": {
          "type": "number",
          "description": "Number of children"
        },
        "eCardCode": {
          "type": "string",
          "description": "Admittance e-card code"
        },
        "notes": {
          "type": "string",
          "description": "Dietary or congratulatory notes"
        },
        "submittedAt": {
          "type": "string",
          "description": "ISO timestamp of RSVP submission"
        }
      },
      "required": ["id", "fullName", "phoneNumber", "willAttend", "submittedAt"]
    }
  },
  "firestore": {
    "/carousel_photos/{photoId}": {
      "schema": {
        "$ref": "#/entities/carouselPhoto"
      },
      "description": "Cloud-stored photos for the wedding carousel gallery"
    },
    "/rsvps/{rsvpId}": {
      "schema": {
        "$ref": "#/entities/rsvpGuest"
      },
      "description": "Guest RSVP submissions"
    }
  }
}
